---
source: tests/claude.rs
expression: "stable(&f, &out)"
---
# onesrc inspect: suggested onesrc.toml. Read-only; secrets shown as ***.

# claude: {home}/.claude.json

[mcp.drifted]
command = "npx"
args = ["drifted-mcp", "--old-flag"]

[mcp.handmade]
command = "handmade-mcp"
args = ["--api-key=***", "***", "--token", "***", "--token=***"]
env = { SERVICE_TOKEN = "***" }
# *** = literal value redacted; move it to secrets.env and reference it as ${VAR}

[mcp.handmade-http]
url = "https://***@api.example.com/mcp/***?key=***&mode=1"
headers = { "X-Api-Key" = "***" }
# *** = literal value redacted; move it to secrets.env and reference it as ${VAR}

[mcp.handmade-sse]
url = "https://api.example.com/sse"
# not modelled: type = "sse"

[mcp.local-tool]
command = "node"
args = ["/opt/tools/local-tool/index.js"]

[mcp.remote]
url = "https://mcp.example.com/mcp"
headers = { "X-Client" = "***" }
# *** = literal value redacted; move it to secrets.env and reference it as ${VAR}
# not modelled by onesrc yet: startup_timeout_sec
# instructions: {home}/.claude/CLAUDE.md (3 lines)
# skills in {home}/.claude/skills: copied, drifted, extra, linked
