---
source: tests/codex.rs
expression: "stable(&f, &out)"
---
# onesrc inspect: suggested onesrc.toml. Read-only; secrets shown as ***.

# codex: {home}/.codex/config.toml

[mcp.drifted]
command = "npx"
args = ["drifted-mcp", "--old-flag"]

[mcp.handmade]
command = "handmade-mcp"
args = ["--api-key=***", "***"]
env = { SERVICE_TOKEN = "***" }
# *** = literal value redacted; move it to secrets.env and reference it as ${VAR}

[mcp.handmade-http]
url = "https://api.example.com/mcp?key=***&mode=1"
headers = { "X-Api-Key" = "***" }
enabled = false
# *** = literal value redacted; move it to secrets.env and reference it as ${VAR}

[mcp.local-tool]
command = "node"
args = ["/opt/tools/local-tool/index.js"]
env = { LOCAL_TOOL_KEY = "${LOCAL_TOOL_KEY}" }

[mcp.remote]
url = "https://mcp.example.com/mcp"
bearer_token = "${REMOTE_TOKEN}"
# not modelled by onesrc yet: startup_timeout_sec
# instructions: {home}/.codex/AGENTS.md (3 lines)
# skills in {home}/.agents/skills: copied, drifted, linked
# skills in {home}/.codex/skills: extra
